        </settingConfig>
    </setting>

    <!-- Free-form metres rather than a three-way list, so a measured course
         (42400 m) can be entered as easily as a standard distance.  The same
         value is editable on the watch under Race Setup, with a preset list.
         There is deliberately no goal-time setting: the goal time is target
         pace x this distance, so the two can never contradict each other. -->
    <setting propertyKey="@Properties.raceDistanceM" title="@Strings.settingTargetDistTitle"
             prompt="@Strings.settingTargetDistPrompt">
        <settingConfig type="numeric" min="500" max="200000"
                       errorMessage="@Strings.settingTargetDistError" />
    </setting>

